# 공개 저장소에 커밋해도 되는 환경 변수 템플릿이다.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 Git에서 무시된다.
#   cp .env.example .env

DB_NAME=portfolio
DB_USER=portfolio_user
# 필수: openssl rand -base64 32 등으로 생성한 값을 입력한다.
DB_PASSWORD=
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/portfolio

SERVER_PORT=8080
APP_PUBLIC_BASE_URL=http://localhost:8080
# 선택: 비어 있으면 관리자 이미지 업로드 API가 비활성화된다.
ADMIN_KEY=
UPLOAD_DIR=./uploads
